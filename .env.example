DATABASE_URL=sqlite:///./storage/clinic.db
DEFAULT_TENANT_ID=TENANT-001
DEFAULT_CLINIC_ID=CLINIC-001
CLINIC_TIMEZONE=Asia/Karachi

# RAG
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.30
RAG_COLLECTION_NAME=clinic_knowledge
EMBEDDING_BACKEND=auto

# LLM
LLM_ENABLED=false
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=400
LLM_TIMEOUT_SECONDS=15
